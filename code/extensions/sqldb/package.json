{
    "name": "@extensions/sqldb",
    "version": "1.0.0",
    "main": "src/index.ts",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "sync-db-types": "tsx sync-types.ts"
    },
    "bin": {
        "sync-db-types": "./sync-types.ts"
    },
    "dependencies": {
        "better-sqlite3": "~11.7.0",
        "kysely": "^0.27.3",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.8",
        "@types/jest": "^29.5.14",
        "@types/node": "^17.0.21",
        "@types/pg": "^8.11.0",
        "@typescript-eslint/eslint-plugin": "^5.15.0",
        "@typescript-eslint/parser": "^5.15.0",
        "eslint": "^8.11.0",
        "jest": "^29.7.0",
        "kysely-codegen": "^0.20.0",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.19.3",
        "typescript": "^4.6.2"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/src/**/__tests__/**/*.test.ts"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "setupFiles": [
            "<rootDir>/jest.setup.ts"
        ],
        "testTimeout": 15000
    }
}
