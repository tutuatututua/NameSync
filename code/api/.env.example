PORT=8080
NODE_ENV=development
ENVIRONMENT=TEST
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX_REQUESTS=500
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads

# Database (SQLite for development, PostgreSQL for production)
DATABASE_FILE=database.db
DATABASE_URL=sqlite:database.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Webhook URLs for external processing services
COMPANY_WEBHOOK_URL=
FACEBOOK_WEBHOOK_URL=
COMPARE_WEBHOOK_URL=

# Public base URL external services use to POST results back. Must be an absolute
# http(s) URL (e.g. an ngrok URL in local dev). If unset/invalid, the server derives
# it from the incoming request.
WEBHOOK_CALLBACK_URL_BASE=
