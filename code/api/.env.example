# ── Runtime ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins. REQUIRED in production (no allow-all fallback).
CORS_ORIGIN=http://localhost:3000
# Directory for temporary uploaded files (deleted immediately after parsing).
UPLOAD_DIR=uploads

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Standardized on Postgres for dev/test/prod. YOU SUPPLY THE DATABASE: the local `postgres`
# compose service was removed on 2026-07-17, so nothing in this repo starts one. Point this at
# a Postgres you control. The default below is the conventional local one (host port 55432),
# which is also where `npm test` looks unless TEST_DATABASE_URL says otherwise.
#
# The app never creates tables (DB_SKIP_MIGRATE=1) — build the schema yourself from
# docs/schema-redesign.sql, and change a live one with a script from docs/migrations/ applied
# by hand (`psql "$DATABASE_URL" -f ...`). See docs/DB.md.
DATABASE_URL=postgres://namesync:namesync@localhost:55432/namesync
# The schema every unqualified table name resolves in (pins search_path). The app's tables
# live in `lakeshore` — in production, inside a database shared with other services, which
# is why they are namespaced at all. Unset => `public`, where the app will find nothing.
DB_SCHEMA=lakeshore
# Force a specific engine (optional). Leave unset to use DATABASE_URL (postgres).
# Values: postgres | sqlite-file | sqlite-mem   (sqlite pools exist for extension tests)
# DB_ENGINE=postgres

# ── External matcher webhooks ───────────────────────────────────────────────
# Who does the matching.
#
# Off (the default): NameSync scores names itself, in Postgres, and a compare run finishes
# inside the request that started it. An import is just an import.
#
# On: the external workflow is the matcher. Importing a file also *starts a run* — the rows
# land at status='processing', the CSV goes to the webhook below, and the workflow stamps
# each row 'match'/'unmatch' and writes the pairs into comparison_result directly. NameSync
# follows it by polling its own tables; there is no callback.
#
# The database must have the columns the workflow writes to BEFORE turning this on — the app
# cannot add them itself (DB_SKIP_MIGRATE=1). A schema built from docs/schema-redesign.sql
# already has them; an older one needs the scripts in docs/migrations/ applied by hand, ending
# with 2026-07-17-single-clean-name-and-result-status.sql.
#
# That last one is a BREAKING change for the workflow, not just for us: it drops
# comparison_result.is_complete (replaced by `status`) and the _clean name columns. Coordinate
# it with whoever owns the workflow — see docs/EXTERNAL-MATCHER.md for the full contract.
EXTERNAL_MATCHER=

# The comparison is performed by an external service. These are optional; the API
# fails loudly per-request if a needed one is missing.
COMPANY_WEBHOOK_URL=
FACEBOOK_WEBHOOK_URL=
# Public base URL the external service POSTs results back to. Must be an absolute
# http(s) URL (e.g. an ngrok URL in local dev). If unset/invalid the server derives
# it from the incoming request.
WEBHOOK_CALLBACK_URL_BASE=

# ── Auth-lite ───────────────────────────────────────────────────────────────
# Shared secret required (as X-Callback-Token) on /api/callbacks/* and destructive
# /all endpoints. Optional in dev; set a strong value in production.
CALLBACK_TOKEN=

# ── Auth (sign-in) ──────────────────────────────────────────────────────────
# NameSync signs people in itself: a password against `app_user`, then an opaque session
# token in an httpOnly cookie. There is NO secret, issuer or JWKS to configure — the app
# is its own issuer. Create the first account with:
#
#   npm run create-user -- you@example.com 'a long passphrase' --name "You" --admin
#
# (There is no `npm run migrate`, and no migration runner. The `app_user` table the command
# writes to comes from the schema — docs/schema-redesign.sql, or docs/add-auth.sql for a
# database that predates auth.)
#
# Idle timeout for a session, in hours. It slides on use. Default 168 (7 days).
SESSION_TTL_HOURS=168
# Cookie policy. `lax` is correct when the site and the API share a registrable domain
# (localhost:3000 -> localhost:4000 counts, since the port is not part of the "site").
# A genuinely cross-site deployment needs `none`, which the browser only honours with
# AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax
# Defaults to true in production, false elsewhere. Only set it to override.
# AUTH_COOKIE_SECURE=true
# Only needed to share the cookie across subdomains, e.g. .example.com
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_NAME=namesync_session

# Dev/test escape hatch: skip auth entirely and treat every request as a local admin, so
# `npm run dev` works against an empty database. REFUSED in production (the app exits).
# AUTH_DISABLED=1

# ── Email one-time-code sign-in (2FA) + SMTP ────────────────────────────────
# A second, NameSync-owned login: the password is the first factor, and NameSync then EMAILS
# a 6-digit code that must be entered to finish signing in — the same two-step as Center's
# email 2FA, but minted here. Drive it from the login form with NEXT_PUBLIC_AUTH_MODE=local
# (see frontend). The code is delivered over the SMTP server below.
#
# Apply the table once: `psql "$DATABASE_URL" -f docs/add-otp-login.sql` (a fresh schema from
# docs/schema-redesign.sql already has it).
#
# With SMTP_HOST set, mail is actually sent. Left UNSET in dev/test, the mailer instead logs
# the code to the server log so the flow works with no mail server. A production deploy that
# relies on this path MUST set real SMTP (the app fails at boot if SMTP_HOST is the only way
# in without a From address). Works with Gmail, SES SMTP, Mailtrap, Postmark SMTP, etc.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Implicit TLS on connect (true => port 465). Most providers use false + STARTTLS on 587.
# SMTP_SECURE=false
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# The From: address on OTP mail. Falls back to SMTP_USER when unset.
# SMTP_FROM=NameSync <no-reply@example.com>
# How long an emailed code is valid (minutes) and how many wrong guesses it survives.
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5

# ── Center sign-in (centerapp.io) ───────────────────────────────────────────
# The PRODUCTION login. NameSync forwards the login form's email+password to Center's auth
# API; on success it reads the profile, matches an existing `app_user` by email, and mints
# its own session cookie (Center's token is used once and discarded). There is no
# auto-provisioning — a Center user with no `app_user` row is turned away.
#
# In production a deploy needs at least ONE real sign-in path: Center (this) and/or email-OTP
# (SMTP_HOST above) — the app refuses to boot with neither. The local password path above is
# dev-only. A trailing slash is optional. Example:
#   CENTER_PLAYME_URL=https://centerapp.io/center/
CENTER_PLAYME_URL=
# The IAM2 group id Center expects on a login/sendcode call (from client registration —
# see docs/wayfinder ticket 07). Optional; sent when set.
# CENTER_GROUP_IAM2_ID=
