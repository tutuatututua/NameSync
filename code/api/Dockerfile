# syntax=docker/dockerfile:1

# ---- Builder: install the whole workspace (incl. native modules) ----
FROM node:20-bookworm-slim AS builder
WORKDIR /app

# Toolchain for native modules (better-sqlite3). Lives only in this stage.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

# The `test` workspace depends on Playwright; don't pull its browsers here.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# package-lock.json is generated by npm 11, which folds the root `overrides` (eslint 9,
# @typescript-eslint 8) into extensions/sqldb's older eslint 8 / @typescript-eslint 5
# ranges and records only the overridden versions. node:20's bundled npm 10 resolves
# overrides differently: it wants sqldb's declared eslint 8.57.1 / 5.62.0, doesn't find
# them in the lock, and `npm ci` dies with EUSAGE "package.json and package-lock.json are
# not in sync" — naming 39 packages nobody asked for directly.
#
# So the lockfile is not npm-version-agnostic, and the build must use the major that
# wrote it. Pinned rather than floating: `npm ci` is only reproducible if the resolver
# is pinned too.
RUN npm install -g npm@11

# Copy every workspace manifest first so `npm ci` can build the exact tree the
# lockfile describes, and so this layer caches across source-only changes.
COPY package.json package-lock.json ./
COPY api/package.json api/package.json
COPY frontend/package.json frontend/package.json
COPY test/package.json test/package.json
COPY extensions/sqldb/package.json extensions/sqldb/package.json
COPY extensions/contract/package.json extensions/contract/package.json
RUN npm ci

# Application source (node_modules is excluded via .dockerignore).
COPY . .

# ---- Runtime: slim image without the build toolchain ----
FROM node:20-bookworm-slim AS runtime
WORKDIR /app/api

ENV NODE_ENV=production \
    DB_ENGINE=postgres \
    PORT=4000 \
    UPLOAD_DIR=/data/uploads \
    DB_SKIP_MIGRATE=1
# DATABASE_URL is supplied at runtime (docker-compose / deploy env), not baked in.
#
# DB_SKIP_MIGRATE=1 is not a test-runner convenience here: the app must never issue DDL
# against the database. The schema is owned out-of-band (docs/schema-redesign.sql for a
# fresh database, docs/migrations/*.sql applied by hand thereafter) because `lakeshore`
# lives inside a database shared with other services. Without this, base.model migrates
# on boot as a "safety net" — see extensions/sqldb/src/base.model.ts.

# Hoisted dependencies, the API source, and the TypeScript-only workspace
# package the API imports as source (@extensions/sqldb). The node_modules
# symlink to it is preserved by COPY.
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/extensions /app/extensions
COPY --from=builder /app/api /app/api

# /data holds uploaded files (temporary); it is backed by a volume at runtime.
RUN mkdir -p /data && chown node:node /data
USER node

EXPOSE 4000
# Run via tsx (transpile on the fly): the sqldb/contract extensions are consumed
# as TS source, so there is no compiled dist to `node` directly. exec, so the server
# is PID 1 and receives SIGTERM for graceful shutdown.
#
# No migrate step: the schema is applied out-of-band, never by a booting container.
CMD ["/app/node_modules/.bin/tsx", "src/server.ts"]
